# Intentionally invalid example. Copy it to .env.deploy.secret only on the deployment host, then replace every value.
# Deploy validation accepts only distinct 256-bit hexadecimal values from `openssl rand -hex 32`.
SPRING_DATASOURCE_URL=jdbc:postgresql://database-host:5432/vibe_hr
SPRING_DATASOURCE_USERNAME=replace-with-deployment-user
SPRING_DATASOURCE_PASSWORD=replace-with-deployment-password
# Use `openssl rand -hex 32`. AUTH and BFF values must differ.
AUTH_TOKEN_SECRET=replace-with-invalid-auth-token-secret
# Separate HMAC secret shared only by the Next.js BFF and Spring API container.
VIBEHR_BFF_ASSERTION_SECRET=replace-with-invalid-bff-assertion-secret
