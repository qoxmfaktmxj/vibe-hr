# Non-sensitive deploy configuration (tracked)
APP_NAME=Vibe-HR API
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://hr.minseok91.cloud
SPRING_PROFILES_ACTIVE=flyway-cutover
VIBEHR_SCHEMA_OWNER=flyway

# The BFF may send credentials only to the Docker-internal Spring API service.
VIBEHR_BFF_BACKEND_URL=http://backend:8080
# The external reverse proxy must remove client-supplied copies and set exactly one canonical IP literal here.
VIBEHR_BFF_TRUSTED_CLIENT_IP_HEADER=x-vibehr-client-ip
APP_ORIGIN=https://hr.minseok91.cloud
NEXT_PUBLIC_APP_ORIGIN=https://hr.minseok91.cloud
